---
// Label says what happens. No arrow glyph.
interface Props { value: string; }
const { value } = Astro.props;
---
<button class="copy" data-value={value}>Copy install command</button>

<style>
  .copy {
    background-color: var(--signal);
    color: var(--base);
    font-family: var(--font-sans);
    font-size: var(--size-body);
    line-height: var(--lh-body);
    padding: var(--space-1) var(--space-2);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
    transition: transform 0.12s ease-out, box-shadow 0.12s ease-out;
  }

  .copy:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgb(224 78 27 / 25%);
  }

  .copy:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgb(224 78 27 / 20%);
  }

  .copy:focus-visible {
    /* global tokens.css already handles :focus-visible; this just nudges
       the offset so the ring sits outside the lifted shadow. */
    outline-offset: 3px;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      await navigator.clipboard.writeText(btn.dataset.value ?? "");
      const original = btn.textContent;
      btn.textContent = "Copied";
      // The conversion event that actually matters. Pageviews tell you the
      // social post worked; this tells you the page worked.
      (window as any).cfBeacon?.track?.("install_copy");
      setTimeout(() => { btn.textContent = original; }, 2000);
    });
  });
</script>

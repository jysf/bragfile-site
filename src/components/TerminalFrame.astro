---
// Real output only. Never recolor it. No window chrome, no traffic-light
// dots — the authenticity is the point. On mobile the frame scrolls
// horizontally rather than shrinking the type.
interface Props { command?: string; }
const { command } = Astro.props;
---
{/* tabindex + role: the frame is a horizontal scroll container, and a
    scroll container that nothing can focus is unreachable by keyboard —
    the clipped columns simply do not exist for anyone not using a
    pointer. */}
<div
  class="frame"
  tabindex="0"
  role="region"
  aria-label={command ? `terminal output: ${command.split("\n")[0]}` : "terminal output"}
>
  {/* One scroller, not two. The command line used to carry its own
      overflow-x, so scrolling the command left the output behind and the
      two halves of a single session drifted out of register. */}
  <div class="frame-track">
    {command && <div class="cmd">$ {command}</div>}
    <pre><slot /></pre>
  </div>
</div>

<style>
  .frame {
    background-color: var(--panel);
    padding: var(--space-3);
    overflow-x: auto;

    /* Bezel hairline — same edge motif as the hero image and the stats
       panel, so frames stay visible when they sit on a band of their
       own color (e.g. spark examples inside the panel band). */
    box-shadow: 0 0 0 1px rgb(255 255 255 / 8%);
  }

  /* Shrink-to-fit so the track is as wide as its widest line, and both
     children scroll as one. */
  .frame-track {
    display: inline-block;
    min-width: 100%;
  }

  .cmd {
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    line-height: var(--lh-meta);
    color: var(--muted);
    margin-bottom: var(--space-2);

    /* Commands are pre-formatted: long flag lists break with explicit
       backslash continuations (as a real shell shows them), never
       word-wrapped at arbitrary points. */
    white-space: pre;
  }

  pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--size-data);
    line-height: var(--lh-data);
    color: var(--output);
    white-space: pre;
  }
</style>

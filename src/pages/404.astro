---
import Base from "../layouts/Base.astro";
import Placard from "../components/Placard.astro";
---
<Base title="No entry found" description="That page isn't in the log.">
  <section>
    <h1>No entry found</h1>
    <div class="mt-3">
      <Placard fields={{ Query: "unknown path", Results: "0", Suggestion: "try the home page" }} />
    </div>
    <p class="mt-6"><a href="/">Back to the log</a></p>
  </section>
</Base>

<style>
  section {
    max-width: var(--column);
    padding: var(--space-12) var(--space-3);
  }

  h1 {
    font-family: var(--font-sans);
    font-size: var(--size-head);
    line-height: var(--lh-head);
    font-weight: 600;
  }
  .mt-3 { margin-top: var(--space-3); }
  .mt-6 { margin-top: var(--space-6); }

  a {
    font-family: var(--font-mono);
    font-size: var(--size-data);
    line-height: var(--lh-data);
    color: var(--signal);
  }
</style>

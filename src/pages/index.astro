---
import Base from "../layouts/Base.astro";
import TerminalFrame from "../components/TerminalFrame.astro";
import DataRow from "../components/DataRow.astro";
import Placard from "../components/Placard.astro";
import Finding from "../components/Finding.astro";
import CopyButton from "../components/CopyButton.astro";
import Freshness from "../components/Freshness.astro";
import { findings, stats } from "../lib/log";

const title = "bragfile — the flight recorder for your work";
const description = "A local-first CLI that captures what you got done. SQLite at ~/.bragfile/db.sqlite. No cloud.";

// Build stamp — src/data/build.json is written by the build-stamp Vite
// plugin (enforce: "pre", buildStart), so it is fresh on disk before this
// module is transformed.
//
// This is an `import`, not a readFileSync, on purpose. Vite inlines the
// JSON into the bundle at build time, so it needs no filesystem and no
// process.cwd() when the route is rendered. The previous fs-based read
// worked locally but returned "dev" in production: `wrangler deploy` finds
// no wrangler config, runs `astro add cloudflare`, and rebuilds with the
// adapter — and under that adapter the node:fs read failed and the catch
// swallowed it. See 46de25d.
import buildData from "../data/build.json";

const buildShaRaw = (buildData as { sha?: string }).sha ?? "dev";
const buildSha = buildShaRaw.slice(0, 7);
const buildIsLocal = buildShaRaw === "dev";

---
<Base title={title} description={description}>

  <header class="rec-strip" aria-label="recording indicator">
    <span class="rec-dot"></span>
    <span class="rec-word">bragfile</span>
    <span class="rec-sep">·</span>
    <span class="rec-time">REC</span>
    <a class="rec-gh" href="https://github.com/jysf/bragfile000" data-track="github-cta" aria-label="GitHub">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
        <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/>
      </svg>
    </a>
  </header>

  {/* 1 — HERO. Base band. */}
  <section class="band band-base">
    <div class="column">
      <h1>The flight recorder for your work.</h1>
      <p class="lede">A local-first CLI for capturing what you got done — shipped, fixed, learned, mentored — into SQLite at <code>~/.bragfile/db.sqlite</code>. No cloud, no account, no sync.</p>
      <div class="mt-6">
        <CopyButton value="brew install jysf/tap/bragfile" track="copy-install-hero" />
        <p class="cta-command">brew install jysf/tap/bragfile</p>
      </div>
    </div>
    <div class="wide">
      <img
        src="/hero.apng"
        alt="brag spark --week terminal output: 120 entries this week, pulse chart by project"
        width="1200"
        height="630"
        class="hero-img"
      />
    </div>
  </section>

  {/* 2 — PROBLEM. Panel band. Single illustration: the raccoon at the
       laptop, blank form on the desk. */}
  <section class="band band-panel">
    <div class="column">
      <h2>You forget. The blank review form.</h2>
      <p class="mt-2">The retro where you can't remember what you shipped. The review form you stare at for an hour. The resume you started from scratch for the third time.</p>
      <figure class="forgot-figure mt-6">
        <picture>
          <source srcset="/forgot-raccoon.webp" type="image/webp" />
          <img
            src="/forgot-raccoon.png"
            alt="An anthropomorphic raccoon software developer at a desk, staring blankly at a laptop while a blank form and question-marked sticky notes sit beside an untouched coffee mug. Mood: mildly defeated, 'I forgot what I shipped this week'."
            loading="lazy"
            width="1024"
            height="1024"
          />
        </picture>
        <figcaption>the blank page</figcaption>
      </figure>
      <p class="mt-6">You did the work. You just can't find it. bragfile records it as it happens, so future-you doesn't have to reconstruct it.</p>
    </div>
  </section>

  {/* 3 — INPUTS. Base band. Two flows side-by-side, same database. */}
  <section class="band band-base">
    <div class="column">
      <h2>What goes in.</h2>
      <p class="mt-2">Two ways to capture. By you, or by your agent. Same database.</p>
    </div>
    <div class="wide">
      <div class="flows mt-6">
        <TerminalFrame command={'brag add -t "shipped the schema fix" \\\n           -p bragfile-site \\\n           -T "db,hero,agent:adal,model:glm-5.3,session:17748077" \\\n           -k shipped'}>
{`+ entry 591
  tags: db,hero,agent:adal,model:glm-5.3
        session:17748077`}
        </TerminalFrame>
        <div class="flows-junction" aria-hidden="true">
          <span class="flows-junction-line"></span>
          <span class="flows-junction-label mono">sqlite</span>
        </div>
        <TerminalFrame command="brag mcp install">
{`✓ connected
claude-code · claude-desktop · cursor
your agent records its own work,
alongside yours`}
        </TerminalFrame>
      </div>
    </div>
  </section>

  {/* 4 — OUTPUTS. Panel band. Display-scale stats panel. */}
  <section class="band band-panel">
    <div class="column">
      <h2>What comes out.</h2>
    </div>
    <div class="wide">
      <div class="stats-panel mt-6">
        <div class="stats-header">
          <span class="mono"># Bragfile Coverage</span>
          <span class="mono muted">scope: year · 567 entries</span>
        </div>
        <div class="stats-grid">
          <div class="stat">
            <div class="stat-num">567</div>
            <div class="stat-label">entries</div>
          </div>
          <div class="stat">
            <div class="stat-num accent">45.5%</div>
            <div class="stat-label">agent-authored</div>
          </div>
        </div>
        <div class="trend-row">
          <span class="trend-label mono muted">monthly agent share</span>
          <span class="trend-bars">▁▁▁▁▁▁▃▇█</span>
        </div>
      </div>
      <div class="flows mt-6">
        <TerminalFrame command="brag spark --week">
{`Total (76): ▇█▂▂▄▅▁
cc-pilot-harness (44): ▇█▂▃▁▁▁
bragfile-site (32): ▁▁▃▂▇█▃`}
        </TerminalFrame>
        <TerminalFrame command="brag spark --month">
{`Total (221): ▁▁█▅
cc-pilot-harness (162): ▁▁█▄
bragfile-site (32): ▁▁▁█
brag (12): ▆▁█▁
crustyimg (3): █▅▁▁`}
        </TerminalFrame>
      </div>
    </div>
  </section>

  {/* 5 — LOG. Base band. Act-break spacing — the recursive concept earns room. */}
  <section class="band band-base act">
    <div class="column">
      <h2>The log.</h2>
      <p class="mt-2">Every step of building this page was captured by the tool the page is about. The findings below are real entries, not illustrations.</p>
      <div class="mt-3">
        <Placard fields={{
          Generated: new Date().toISOString(),
          Scope: "hackathon week",
          Entries: String(stats.total),
        }} />
        <div class="mt-1"><Freshness /></div>
      </div>
    </div>
    {/* Terminal-style tabular output breaks wider, like the frames in
       sections 1/3/4 — the fixed 85ch columns need more than 720px. */}
    <div class="wide">
      {/* Scroll container — the spec's mobile rule for tabular output:
          horizontal scroll inside the frame, never shrink the type.
          Mirrors the TerminalFrame pattern. */}
      <div class="log-scroll mt-6">
        <table class="log-table">
        <colgroup>
          <col class="col-text" />
          <col class="col-type" />
          <col class="col-date" />
          <col class="col-id" />
        </colgroup>
        <thead>
          <tr>
            <th>text</th>
            <th>type</th>
            <th>date</th>
            <th>id</th>
          </tr>
        </thead>
        <tbody>
          {findings.map((f) => (
            <tr>
              <td>{f.text}</td>
              <td>{f.type}</td>
              <td>{f.date.slice(0, 10)}</td>
              <td class="log-id">{f.id}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </div>
  </section>

  {/* 6 — INSTALL. Signal band. The one loud moment — copy install CTA.
     Tighter padding (cta class) so the page arrives at the install
     moment instead of padding around it. */}
  <section class="band band-signal cta">
    <div class="column">
      <h2>Nothing leaves your machine.</h2>
      <p class="mt-2">The database is a file. The export is a file. The tool is a binary.</p>
      <p class="mt-2">Capture what happened. Find it when it counts.</p>
      <div class="mt-6">
        <CopyButton value="brew install jysf/tap/bragfile" inverse track="copy-install-footer" />
        <p class="cta-command">brew install jysf/tap/bragfile</p>
      </div>
    </div>
  </section>

  {/* Attribution — sits below the CTA panel on --base, outside the
       band's signal. Quiet mono line, two reference URLs. */}
  <footer class="attribution">
    <span class="attribution-line">
      <span>made by jysf</span>
      <span class="attribution-sep">·</span>
      <a href="https://jysf.org/?source=bragfile" data-track="jysf-org-footer">jysf.org</a>
      <span class="attribution-sep">·</span>
      <a class="github-icon" href="https://github.com/jysf/bragfile000" data-track="github-footer" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/>
        </svg>
      </a>
    </span>
    <span class="build-stamp" title={buildIsLocal ? "local build (no commit source found)" : `deployed ${buildShaRaw}`}>build {buildSha}</span>
  </footer>

</Base>

<style>
  /* ===== Top recording strip — replaces the panel page-header. ===== */
  .rec-strip {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
    height: 40px;
    padding: 0 var(--space-3);
    background-color: var(--panel);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    line-height: var(--lh-meta);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  /* Pulsing dot at the strip's left edge — small, breathing, sits at the
     reading position so the strip feels alive rather than decorative. */
  .rec-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--signal);
    animation: rec-pulse 1.6s ease-in-out infinite;
  }

  @keyframes rec-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }

    50% {
      opacity: 0.4;
      transform: scale(0.85);
    }
  }

  .rec-word {
    color: var(--text);
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .rec-time {
    color: var(--muted);
    letter-spacing: 0.18em;
  }
  .rec-sep { opacity: 0.4; }

  /* GitHub icon pinned to the strip's right edge — same repo link the
     CTA carried, moved to the header. Inherits the strip's muted mono.
     Padding expands the hit area to ~44px; negative margin keeps the
     glyph's visual position unchanged. */
  .rec-gh {
    position: absolute;
    right: var(--space-3);
    display: inline-flex;
    align-items: center;
    padding: var(--space-2);
    margin: calc(-1 * var(--space-2));
    color: var(--muted);
  }
  .rec-gh:hover { color: var(--text); }

  /* ===== Section bands — full-bleed, alternating rhythm.
     Content inside the column wraps to 720/960 columns. ===== */
  section {
    padding: var(--space-12) var(--space-3);
  }

  section.act {
    padding: var(--space-12) var(--space-3);
  }

  /* §6 coda — closer vertical padding so the page arrives at the
     install moment instead of padding around it. */
  section.cta {
    padding: var(--space-8) var(--space-3);
  }

  .column {
    max-width: var(--column);
  }

  .wide {
    margin-top: var(--space-3);
    max-width: var(--column-wide);
  }
  .band-base { background-color: var(--base); }
  .band-panel { background-color: var(--panel); }

  .band-signal {
    background-color: var(--signal);
    color: var(--base);
  }
  .band-signal h2 { color: inherit; }

  /* ===== Typography ===== */
  h1 {
    font-family: var(--font-sans);
    font-size: var(--size-hero);
    line-height: var(--lh-hero);
    font-weight: 600;
    max-width: 16ch;
    letter-spacing: -0.025em;
  }

  h2 {
    font-family: var(--font-sans);
    font-size: var(--size-head);
    line-height: var(--lh-head);
    font-weight: 600;
  }
  p { max-width: var(--measure); }
  .lede { margin-top: var(--space-3); }

  /* ===== Flow row (section 3) — two terminal frames side by side with a
     center connector that names the database they both write to. ===== */
  .flows {
    display: flex;
    align-items: stretch;
    gap: var(--space-3);
    max-width: var(--column-wide);
  }

  .flows-junction {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-1);
    min-width: 96px;
  }

  .flows-junction-line {
    flex: 1;
    width: 1px;
    background-color: var(--muted);
    min-height: 32px;
  }

  .flows-junction-label {
    font-size: var(--size-meta);
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ===== Stats panel — section 4's display-scale numbers ===== */
  .stats-panel {
    background-color: var(--base);
    padding: var(--space-6);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 8%);
  }

  .stats-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--panel);
    font-family: var(--font-mono);
    font-size: var(--size-data);
    line-height: var(--lh-data);
    color: var(--text);
  }
  .muted { color: var(--muted); }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    padding: var(--space-6) 0 var(--space-4);
  }

  .stat-num {
    font-family: var(--font-sans);
    font-size: var(--size-display-md);
    font-weight: 700;
    line-height: var(--lh-display);
    color: var(--text);
    letter-spacing: -0.04em;
  }
  .stat-num.accent { color: var(--signal); }

  .stat-label {
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: var(--space-2);
  }

  .trend-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: var(--space-3);
    border-top: 1px solid var(--panel);
  }

  .trend-label {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .trend-bars {
    font-family: var(--font-mono);
    font-size: var(--size-trend);
    color: var(--text);
    letter-spacing: 0.1em;
  }

  /* §2 single illustration — sits on a base-colored "paper" with a
     hairline outline, capped at column-wide so it reads as one composed
     image rather than a wall. */
  .forgot-figure {
    margin: 0;
    max-width: var(--column-wide);
    background-color: var(--base);
    padding: var(--space-2);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 4%);
  }

  .forgot-figure img {
    display: block;
    width: 85%;
    margin: 0 auto;
    height: auto;
    background-color: var(--base);
  }

  .forgot-figure figcaption {
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    line-height: var(--lh-meta);
    color: var(--muted);
    text-align: center;
    margin-top: var(--space-2);
    letter-spacing: 0.04em;
  }

  /* ===== §5 log table — tabular treatment replacing the Finding cards. ===== */
  .log-scroll {
    overflow-x: auto;
  }

  .log-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--size-data);
    line-height: var(--lh-data);
    color: var(--text);

    /* Column proportions: id (small), date (medium), type (medium),
       text (large). Text caps at 52ch so the text column reads as a
       measurement, not a wall. */
    table-layout: fixed;
  }
  .log-table col.col-id   { width: 5ch; }
  .log-table col.col-date { width: 12ch; }
  .log-table col.col-type { width: 12ch; }
  .log-table col.col-text  { width: 56ch; }

  .log-table thead th {
    text-align: left;
    font-weight: 400;
    color: var(--muted);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--panel);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--size-meta);
    line-height: var(--lh-meta);
  }

  .log-table tbody td {
    padding: var(--space-3);
    border-bottom: 1px solid var(--panel);
    vertical-align: top;
  }
  .log-table tbody tr:last-child td { border-bottom: 0; }

  /* Right-align the trailing numeric column (id). The id is the
     citation index — small, muted, mono, sits at the row's right edge. */
  .log-table td.log-id,
  .log-table th.col-id {
    text-align: right;
    color: var(--muted);
    font-size: var(--size-meta);
    line-height: var(--lh-meta);
  }

  /* ===== Utility ===== */
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .mt-1 { margin-top: var(--space-1); }
  .mt-2 { margin-top: var(--space-2); }
  .mt-3 { margin-top: var(--space-3); }
  .mt-6 { margin-top: var(--space-6); }
  .mono { font-family: var(--font-mono); }

  /* ===== Inline code ===== */
  code {
    font-family: var(--font-mono);
    font-size: var(--size-data);
    line-height: var(--lh-data);
    color: var(--text);
  }

  /* ===== Hero image — instrument bezel hairline ===== */
  .hero-img {
    display: block;
    width: 100%;
    height: auto;
    background-color: var(--panel);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 8%);
  }

  /* ===== §6 CTA — install button does the loud work; the command as
     scannable text sits under it, dimmed so the button stays loud. ===== */

  /* Install command as scannable text under the button — mono because it
     is a real command; inherits band color so it works on both the hero
     (--text on --base) and the signal band (--base on --signal). */
  .cta-command {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    line-height: var(--lh-meta);
    opacity: 0.6;
    letter-spacing: 0.04em;
  }

  /* ===== Attribution — quiet mono line below the CTA on --base. ===== */
  .attribution {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-3);

    /* Safe-area: keep the footer clear of the home-indicator curve.
       max() picks the larger of token padding and the inset. */
    padding-left: max(var(--space-3), env(safe-area-inset-left));
    padding-right: max(var(--space-3), env(safe-area-inset-right));
    padding-bottom: max(var(--space-4), env(safe-area-inset-bottom));
    background-color: var(--base);
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    line-height: var(--lh-meta);
    color: var(--muted);
  }

  .attribution-line {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: center;
  }

  .attribution a {
    color: var(--muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .attribution a:hover { color: var(--text); }
  .attribution-sep { opacity: 0.4; }

  /* Footer GitHub link is icon-only: drop the shared underline, keep the
     icon on the meta baseline so it reads as part of the mono line.
     Padding expands the hit area to ~44px; negative margin keeps the
     glyph's visual position unchanged. */
  .attribution a.github-icon {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2);
    margin: calc(-1 * var(--space-2));
    text-decoration: none;
  }

  /* Build stamp — sits at the bottom-right of the attribution row.
     Hover reveals the full SHA via title attribute. */
  .build-stamp {
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    color: var(--muted);
    opacity: 0.6;

---
import Base from "../layouts/Base.astro";
import TerminalFrame from "../components/TerminalFrame.astro";
import DataRow from "../components/DataRow.astro";
import Placard from "../components/Placard.astro";
import Finding from "../components/Finding.astro";
import CopyButton from "../components/CopyButton.astro";
import Freshness from "../components/Freshness.astro";
import { findings, stats } from "../lib/log";

const title = "bragfile — the flight recorder for your work";
const description = "A local-first CLI that captures what you got done. SQLite at ~/.bragfile/db.sqlite. No cloud.";
---
<Base title={title} description={description}>

  {/* 1 — HERO. What it is, one command, one real terminal frame. */}
  <section>
    <h1>The flight recorder for your work.</h1>
    <p class="lede">A local-first CLI for capturing what you got done — shipped, fixed, learned, mentored — into SQLite at <code>~/.bragfile/db.sqlite</code>. No cloud, no account, no sync.</p>
    <div class="mt-6"><CopyButton value="brew install jysf/tap/bragfile" /></div>
    <div class="mt-6 wide">
      <img
        src="/hero.apng"
        alt="brag spark --week terminal output: 120 entries this week, pulse chart by project"
        width="1200"
        height="630"
        class="hero-img"
      />
    </div>
  </section>

  {/* 2 — THE PROBLEM. You forget. The blank review form. */}
  <section>
    <h2>You forget. The blank review form.</h2>
    <p class="mt-2">The retro where you can't remember what you shipped. The review form you stare at for an hour. The resume you started from scratch for the third time.</p>
    <p class="mt-2">You did the work. You just can't find it.</p>
    <p class="mt-2">bragfile records it as it happens, so future-you doesn't have to reconstruct it.</p>
  </section>

  {/* 3 — HOW IT WORKS. Numbered — it's genuinely a sequence. */}
  <section>
    <h2>Three commands. That is the whole surface.</h2>
    <ol class="cmds mt-3">
      <li><code>brag add</code> &mdash; capture a thing that happened.</li>
      <li><code>brag search shipped</code> &mdash; find it later, by keyword.</li>
      <li><code>brag export --format markdown</code> &mdash; pull a slice.</li>
    </ol>
  </section>

  {/* 4 — WHAT COMES OUT. Three views of the same data. */}
  <section>
    <h2>What comes out.</h2>
    <p class="mt-2">Three views of the same data, for the three times you'll actually want your history.</p>
    <ul class="outputs mt-3">
      <li><strong>brag spark</strong> &mdash; the pulse: what's been happening, bucketed.</li>
      <li><strong>brag coverage</strong> &mdash; the year-in-review: agent vs human share, with a monthly trend.</li>
      <li><strong>brag export --format markdown</strong> &mdash; the deliverable: the doc itself, ready to paste.</li>
    </ul>
    <div class="mt-6 wide">
      <TerminalFrame command="brag coverage --year">
{`# Bragfile Coverage

Generated: 2026-09-14T23:34:03Z
Scope: year
Filters: (none)
Entries: 567

## Provenance share

- Agent-authored: 258 (45.5%)
- Human-authored: 309 (54.5%)

## Monthly trend

Agent share: ▁▁▁▁▁▁▃▇█`}
      </TerminalFrame>
    </div>
  </section>

  {/* 5 — THE LOG. This page, building itself. Never cut. */}
  <section>
    <h2>This page, building itself.</h2>
    <p class="mt-2">Every step of building this page was captured by the tool the page is about. The findings below are real entries, not illustrations.</p>
    <div class="mt-3">
      <Placard fields={{
        Generated: new Date().toISOString(),
        Scope: "hackathon week",
        Entries: String(stats.total),
      }} />
      <div class="mt-1"><Freshness /></div>
    </div>
    <div class="stack mt-6">
      {findings.map((f, i) => <Finding n={i + 1} date={f.date} text={f.text} />)}
    </div>
  </section>

  {/* 6 — LOCAL-FIRST + CTA. The one loud moment on the page. */}
  <section class="cta">
    <div class="inner">
      <h2>Nothing leaves your machine.</h2>
      <p class="mt-2">The database is a file. The export is a file. The tool is a binary.</p>
      <p class="mt-2">Capture what happened. Find it when it counts.</p>
      <p class="mt-6">
        <a href="https://github.com/jysf/bragfile000">github.com/jysf/bragfile000</a>
      </p>
    </div>
  </section>

</Base>

<style>
  section {
    max-width: var(--column);
    padding: var(--space-12) var(--space-3);
  }
  .wide { max-width: var(--column-wide); }

  h1 {
    font-family: var(--font-sans);
    font-size: var(--size-hero);
    line-height: var(--lh-hero);
    font-weight: 600;
    max-width: 16ch;
  }

  h2 {
    font-family: var(--font-sans);
    font-size: var(--size-head);
    line-height: var(--lh-head);
    font-weight: 600;
  }
  p { max-width: var(--measure); }
  .lede { margin-top: var(--space-3); }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .mt-1 { margin-top: var(--space-1); }
  .mt-2 { margin-top: var(--space-2); }
  .mt-3 { margin-top: var(--space-3); }
  .mt-6 { margin-top: var(--space-6); }

  /* Inline code in body prose — mono, body color, never signal (fails contrast
     at body size on dark). Sections that want command names to pop use a
     more specific selector below. */
  code {
    font-family: var(--font-mono);
    font-size: var(--size-data);
    line-height: var(--lh-data);
    color: var(--text);
  }

  /* Section 3 — numbered command list. Numbering is allowed here because
     the three commands are genuinely a sequence. */
  .cmds {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: decimal inside;
    padding: 0;
    margin: 0;
    font-size: var(--size-body);
    line-height: var(--lh-body);
    color: var(--text);
  }

  .cmds code {
    color: var(--signal);
  }

  /* Section 4 — three outputs, described, then one is shown in full. */
  .outputs {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--size-body);
    line-height: var(--lh-body);
    color: var(--text);
  }

  .outputs strong {
    font-family: var(--font-mono);
    font-size: var(--size-data);
    line-height: var(--lh-data);
    color: var(--text);
    font-weight: 400;
  }

  /* Section 6 — full-bleed signal panel. The one loud moment on the page. */
  .cta {
    max-width: none;
    background-color: var(--signal);
    color: var(--base);
  }
  .cta .inner { max-width: var(--column); }

  .cta a {
    font-family: var(--font-mono);
    font-size: var(--size-data);
    line-height: var(--lh-data);
    color: var(--base);
  }

  @media (width <= 600px) {
    section { padding: var(--space-6) var(--space-2); }
    h1 { font-size: var(--size-head); }
  }

  /* Hero image — full-width inside the wide frame, scale to container. */
  .hero-img {
    display: block;
    width: 100%;
    height: auto;
    background-color: var(--panel);
  }
</style>

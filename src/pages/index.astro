---
import Base from "../layouts/Base.astro";
import TerminalFrame from "../components/TerminalFrame.astro";
import DataRow from "../components/DataRow.astro";
import Placard from "../components/Placard.astro";
import Finding from "../components/Finding.astro";
import CopyButton from "../components/CopyButton.astro";
import Freshness from "../components/Freshness.astro";
import { findings, stats } from "../lib/log";

const title = "bragfile — the flight recorder for your work";
const description = "A local-first CLI that captures what you got done. SQLite at ~/.bragfile/db.sqlite. No cloud.";
---
<Base title={title} description={description}>

  <header class="page-header">
    <span class="wordmark">bragfile</span>
    <span class="indicator" aria-label="recording">
      <span class="rec-dot"></span>
      <span>REC</span>
    </span>
  </header>

  {/* 1 — HERO. Base band. */}
  <section class="band band-base">
    <div class="column">
      <div class="marker">⏺ 01 · HERO</div>
      <h1>The flight recorder for your work.</h1>
      <p class="lede">A local-first CLI for capturing what you got done — shipped, fixed, learned, mentored — into SQLite at <code>~/.bragfile/db.sqlite</code>. No cloud, no account, no sync.</p>
      <div class="mt-6"><CopyButton value="brew install jysf/tap/bragfile" /></div>
    </div>
    <div class="wide">
      <img
        src="/hero.apng"
        alt="brag spark --week terminal output: 120 entries this week, pulse chart by project"
        width="1200"
        height="630"
        class="hero-img"
      />
    </div>
  </section>

  {/* 2 — PROBLEM. Panel band. */}
  <section class="band band-panel">
    <div class="column">
      <div class="marker">⏺ 02 · PROBLEM</div>
      <h2>You forget. The blank review form.</h2>
      <p class="mt-2">The retro where you can't remember what you shipped. The review form you stare at for an hour. The resume you started from scratch for the third time.</p>
      <p class="mt-2">You did the work. You just can't find it.</p>
      <p class="mt-2">bragfile records it as it happens, so future-you doesn't have to reconstruct it.</p>
    </div>
  </section>

  {/* 3 — INPUTS. Base band. Two flows: by hand, by MCP. */}
  <section class="band band-base">
    <div class="column">
      <div class="marker">⏺ 03 · INPUTS</div>
      <h2>What goes in.</h2>
      <p class="mt-2">Two ways to capture. By you, or by your agent. Same database.</p>
      <div class="flows mt-6">
        <TerminalFrame command='brag add "shipped the schema fix"'>
{`+ entry 591`}
        </TerminalFrame>
        <TerminalFrame command="brag mcp install">
{`✓ connected
claude-code · claude-desktop · cursor
your agent records its own work,
alongside yours`}
        </TerminalFrame>
      </div>
    </div>
  </section>

  {/* 4 — OUTPUTS. Panel band. Display-scale stats panel. */}
  <section class="band band-panel">
    <div class="column">
      <div class="marker">⏺ 04 · OUTPUTS</div>
      <h2>What comes out.</h2>
    </div>
    <div class="wide">
      <div class="stats-panel mt-6">
        <div class="stats-header">
          <span class="mono"># Bragfile Coverage</span>
          <span class="mono muted">scope: year · 567 entries</span>
        </div>
        <div class="stats-grid">
          <div class="stat">
            <div class="stat-num">567</div>
            <div class="stat-label">entries</div>
          </div>
          <div class="stat">
            <div class="stat-num accent">45.5%</div>
            <div class="stat-label">agent-authored</div>
          </div>
        </div>
        <div class="trend-row">
          <span class="trend-label mono muted">monthly agent share</span>
          <span class="trend-bars">▁▁▁▁▁▁▃▇█</span>
        </div>
      </div>
    </div>
  </section>

  {/* 5 — LOG. Base band. Act-break spacing — the recursive concept earns room. */}
  <section class="band band-base act">
    <div class="column">
      <div class="marker">⏺ 05 · LOG</div>
      <h2>This page, building itself.</h2>
      <p class="mt-2">Every step of building this page was captured by the tool the page is about. The findings below are real entries, not illustrations.</p>
      <div class="mt-3">
        <Placard fields={{
          Generated: new Date().toISOString(),
          Scope: "hackathon week",
          Entries: String(stats.total),
        }} />
        <div class="mt-1"><Freshness /></div>
      </div>
      <div class="stack mt-6">
        {findings.map((f, i) => <Finding n={i + 1} date={f.date} text={f.text} />)}
      </div>
    </div>
  </section>

  {/* 6 — INSTALL. Signal band. The one loud moment. */}
  <section class="band band-signal">
    <div class="column">
      <div class="marker marker-on-signal">⏺ 06 · INSTALL</div>
      <h2>Nothing leaves your machine.</h2>
      <p class="mt-2">The database is a file. The export is a file. The tool is a binary.</p>
      <p class="mt-2">Capture what happened. Find it when it counts.</p>
      <p class="mt-6">
        <a href="https://github.com/jysf/bragfile000">github.com/jysf/bragfile000</a>
      </p>
    </div>
  </section>

</Base>

<style>
  /* ===== Section bands — full-bleed backgrounds, alternate for rhythm =====
     Sections are full-width so their background color fills the viewport.
     .column / .wide constrain the content INSIDE the section to design widths. */
  section {
    padding: var(--space-6) var(--space-3);
    position: relative;
  }

  section.act {
    /* Act break — breathing room before the recursive concept. */
    padding: var(--space-12) var(--space-3);
  }

  .column {
    position: relative;
    max-width: var(--column);
  }

  .wide {
    margin-top: var(--space-3);
    max-width: var(--column-wide);
  }
  .band-base { background-color: var(--base); }
  .band-panel { background-color: var(--panel); }

  .band-signal {
    background-color: var(--signal);
    color: var(--base);
  }

  /* ===== Section marker — record-button glyph, top-right of each column ===== */
  .marker {
    position: absolute;
    top: var(--space-3);
    right: 0;
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    line-height: var(--lh-meta);
    color: var(--muted);
    letter-spacing: 0.06em;
  }
  .marker-on-signal { color: var(--base); }

  /* ===== Page header — wordmark + REC indicator ===== */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--column);
    padding: var(--space-4) var(--space-3) 0;
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    line-height: var(--lh-meta);
    color: var(--muted);
  }

  .page-header .wordmark {
    color: var(--text);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .page-header .indicator {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--muted);
  }

  .rec-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background-color: var(--signal);
    border-radius: 50%;
    animation: rec-pulse 1.6s ease-in-out infinite;
  }

  @keyframes rec-pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }

    50% {
      opacity: 0.35;
      transform: scale(0.8);
    }
  }

  /* ===== Typography ===== */
  h1 {
    font-family: var(--font-sans);
    font-size: var(--size-hero);
    line-height: var(--lh-hero);
    font-weight: 600;
    max-width: 16ch;
    letter-spacing: -0.025em;
  }

  h2 {
    font-family: var(--font-sans);
    font-size: var(--size-head);
    line-height: var(--lh-head);
    font-weight: 600;
  }
  p { max-width: var(--measure); }
  .lede { margin-top: var(--space-3); }

  /* ===== Flow stack — two terminal frames in section 3 ===== */
  .flows {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--column-wide);
  }

  /* ===== Stats panel — section 4's display-scale numbers ===== */
  .stats-panel {
    background-color: var(--base);
    padding: var(--space-6);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 6%);
  }

  .stats-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--panel);
    font-family: var(--font-mono);
    font-size: var(--size-data);
    line-height: var(--lh-data);
    color: var(--text);
  }
  .muted { color: var(--muted); }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    padding: var(--space-8) 0 var(--space-6);
  }

  .stat-num {
    font-family: var(--font-sans);
    font-size: var(--size-display);
    font-weight: 700;
    line-height: var(--lh-display);
    color: var(--text);
    letter-spacing: -0.04em;
  }
  .stat-num.accent { color: var(--signal); }

  .stat-label {
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: var(--space-2);
  }

  .trend-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: var(--space-3);
    border-top: 1px solid var(--panel);
  }

  .trend-label {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .trend-bars {
    font-family: var(--font-mono);
    font-size: var(--size-trend);
    color: var(--text);
    letter-spacing: 0.1em;
  }

  /* ===== Utility ===== */
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .mt-1 { margin-top: var(--space-1); }
  .mt-2 { margin-top: var(--space-2); }
  .mt-3 { margin-top: var(--space-3); }
  .mt-6 { margin-top: var(--space-6); }
  .mono { font-family: var(--font-mono); }

  /* ===== Inline code ===== */
  code {
    font-family: var(--font-mono);
    font-size: var(--size-data);
    line-height: var(--lh-data);
    color: var(--text);
  }

  /* ===== Section 3 — numbered command list (legacy of earlier design) ===== */
  .cmds {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: decimal inside;
    padding: 0;
    margin: 0;
    font-size: var(--size-body);
    line-height: var(--lh-body);
    color: var(--text);
  }

  .cmds code {
    color: var(--signal);
  }

  /* ===== Hero image — full-width inside the wide frame ===== */
  .hero-img {
    display: block;
    width: 100%;
    height: auto;
    background-color: var(--panel);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 8%);
  }

  /* ===== CTA section — link styling ===== */
  .band-signal a {
    font-family: var(--font-mono);
    font-size: var(--size-data);
    line-height: var(--lh-data);
    color: var(--base);
  }

  @media (width <= 600px) {
    section { padding: var(--space-4) var(--space-2); }
    section.act { padding: var(--space-8) var(--space-2); }

    h1 {
      font-size: var(--size-head);
      letter-spacing: -0.02em;
    }
    .marker { display: none; }
    .page-header .indicator { display: none; }

    .stats-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .stat-num { font-size: var(--size-display-md); }
    .trend-bars { font-size: var(--size-trend-md); }
  }
</style>
